# Placeholders only — no verified hostnames or paths. Fill in per-machine.

# C1 — capture / transcription
C1_HOST=127.0.0.1
C1_PORT=8001

# C2 — reasoning / RAG
C2_HOST=127.0.0.1
C2_PORT=8002

# C3 — interjection router
C3_HOST=127.0.0.1
C3_PORT=8003

# C4 — speech synthesis
C4_HOST=127.0.0.1
C4_PORT=8004

# C5 — orchestrator
C5_HOST=127.0.0.1
C5_PORT=8005

# Ollama endpoint + model tag (C2)
# Pinned per DR-020: tag AND blob digest both cited, because a tag is mutable
# and a digest is not. Do not re-pull/re-tag without filing a new DR.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4-e4b-bakeoff:latest
OLLAMA_MODEL_DIGEST=sha256-90ce98129eb3e8cc57e62433d500c97c624b1e3af1fcc85dd3b55ad7e0313e9f
C2_MAX_TOKENS=40

# C1 — faster-whisper model size/compute
C1_WHISPER_MODEL=small
C1_WHISPER_COMPUTE_TYPE=int8

# C4 — TTS engine selection (DR-018: engine-agnostic interface, kokoro for D0)
C4_TTS_ENGINE=kokoro

# Kokoro TTS weights (C4). Moved off /tmp per DR-014/thread-1.0.6 ruling:
# /tmp is cleared on reboot and does not count as a stable provisioned path.
KOKORO_WEIGHTS_PATH=/home/jester/models/kokoro/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=/home/jester/models/kokoro/voices-v1.0.bin

# C5 — turn-loop / Bar B harness config
C5_TURN_COUNT=10
C5_BAR_B_TURN_COUNT=20
