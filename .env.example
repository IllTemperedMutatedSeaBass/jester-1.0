# Placeholders only — no verified hostnames or paths. Fill in per-machine.

# C1 — capture / transcription
C1_HOST=127.0.0.1
C1_PORT=8001

# C2 — reasoning / RAG
C2_HOST=127.0.0.1
C2_PORT=8002

# C3 — interjection router
C3_HOST=127.0.0.1
C3_PORT=8003

# C4 — speech synthesis
C4_HOST=127.0.0.1
C4_PORT=8004

# C5 — orchestrator
C5_HOST=127.0.0.1
C5_PORT=8005

# Ollama endpoint + model tag (C2)
# Pinned per DR-020: tag AND blob digest both cited, because a tag is mutable
# and a digest is not. Do not re-pull/re-tag without filing a new DR.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4-e4b-bakeoff:latest
OLLAMA_MODEL_DIGEST=sha256-90ce98129eb3e8cc57e62433d500c97c624b1e3af1fcc85dd3b55ad7e0313e9f
C2_MAX_TOKENS=40

# C1 — faster-whisper model size/compute
C1_WHISPER_MODEL=small
C1_WHISPER_COMPUTE_TYPE=int8

# C4 — TTS engine selection (DR-018: engine-agnostic interface, kokoro for D0)
C4_TTS_ENGINE=kokoro

# Kokoro TTS weights (C4). Moved off /tmp per DR-014/thread-1.0.6 ruling:
# /tmp is cleared on reboot and does not count as a stable provisioned path.
KOKORO_WEIGHTS_PATH=/home/jester/models/kokoro/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=/home/jester/models/kokoro/voices-v1.0.bin

# C5 — turn-loop / Bar B harness config
C5_TURN_COUNT=10
C5_BAR_B_TURN_COUNT=20

# C2 — D1 retrieval (thread 1.0.14; DR-008 / DR-032 / DR-033)
# Persist dir is DR-033(b)'s per-stream directory: 1.x's OWN store, never
# 2.x's. Embedding model pinned by DIGEST, not just tag (DR-033) — a moved
# tag silently invalidates every vector already written, with no error at
# write time and no error at read time.
C2_CHROMA_PERSIST_DIR=/home/jester/jester-1.0/c2_reason/chroma_store
C2_EMBED_MODEL=nomic-embed-text:latest
C2_EMBED_MODEL_DIGEST=sha256-970aa74c0a90ef7482477cf803618e776e173c007bf957f635f1015bfcfef0e6
# Set to 0 to reproduce the pre-retrieval D0 baseline on this same build.
C2_RETRIEVAL_ENABLED=1
# DR-032's corpus identifier. One live value at D0.
C2_CORPUS_ID=dhi
# Chunks per retrieval path. Drives the evidence-token cost appended to
# every turn — see DECISIONS.md DR-036 for the context-budget arithmetic.
C2_RETRIEVAL_TOP_K=3

# C2 — context window (thread 1.0.15, DR-040). Raised from 8192 to 16384.
# Measured: delta prefill tracks ACTUAL context occupancy, not the num_ctx
# setting, so a larger window costs ~nothing until it is filled. 16384
# roughly doubles the meeting ceiling (~36 -> ~80 min at 190 tok/min) for
# ~+0.29s of prefill at the far end of a meeting and +16 MiB of compute
# buffer. Reversible with this one variable.
C2_NUM_CTX=16384
# DR-039 overflow guard: how far below num_ctx the guard fires. Ollama does
# NOT error at num_ctx — it silently truncates to ~num_ctx/2 and returns
# HTTP 200, so the guard must fire early, with margin for estimator error.
C2_CONTEXT_GUARD_MARGIN_TOKENS=512

# C3 — interjection gate (thread 1.0.16; DR-042 / DR-043 / DR-044 / DR-006)
# EVERY CONSTANT HERE IS PROVISIONAL. DR-042(c) fixed them so work could
# proceed against a bar, expecting revision once measured; DR-045 records
# why no measurement was available to derive them from. A value here is a
# starting position, not a finding.
# DR-042(a): the hard ceiling — at most 2 interjections per rolling 10 min.
C3_MAX_INTERJECTIONS=2
C3_BUDGET_WINDOW_S=600
# DR-006: a natural gap counts as an opportunity at this much silence.
C3_VAD_GAP_S=1.2
# Task 5(f): a candidate that never gets an opportunity expires rather than
# surfacing minutes late. Half the budget window, deliberately.
C3_CANDIDATE_TTL_S=300
C3_MAX_QUEUE=16
C3_TRANSCRIPT_WINDOW_CHARS=1200
C3_CONFLICT_CHECK_TIMEOUT_S=60
# DR-006's hand-up light is a STUB — no GPIO at D0.
C3_HAND_UP_GPIO_ENABLED=0
# C2's conflict_check reply cap. SEPARATE from C2_MAX_TOKENS, which is the
# spoken-reply cap and a measured figure in DR-020/DR-038.
C2_CONFLICT_MAX_TOKENS=120
# C5 -> C3 wiring. Set C5_C3_ENABLED=0 to reproduce the pre-C3 baseline on
# this same build.
C5_C3_ENABLED=1
C5_C3_ASSUMED_GAP_S=2.0
C5_C3_OBSERVE_TIMEOUT_S=90
